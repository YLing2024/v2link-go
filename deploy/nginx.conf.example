# v2link-go nginx 配置示例（部署模板，只读参考；本仓库不安装、不改动线上 nginx）。
# 复制到 /etc/nginx/conf.d/v2link-go.conf 并把 <YOUR_DOMAIN> 换成实际值后：
#   nginx -t && systemctl reload nginx
#
#   - /v2ws : VLESS WebSocket 入口 → xray 127.0.0.1:7895（公开，不需要登录）
#   - /api/clash/subscriptions/<token> : Clash 抓取（公开，token 即凭据），必须排在 /api/ 之前且窄匹配
#   - /api/ : 控制面 API（builtin 自带鉴权；或经前置认证网关注入 X-Auth-User 后反代）
#   - /     : 前端静态（公开，控制面托管）
#
# 与旧实现的差异：控制面端口由 7897 改为 19245（新旧并存）。本文件不涉及任何真实域名。

server {
    server_name <YOUR_DOMAIN>;

    # ---- VLESS over WebSocket（客户端流量入口）----
    location /v2ws {
        proxy_pass http://127.0.0.1:7895;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Clash 订阅抓取（公开，token 即凭据）----
    # 红线：① 不经过认证网关（Clash 抓取不带 Cookie）
    #       ② 必须窄匹配：POST /api/clash/subscriptions（创建，需鉴权）不能被这条吞掉
    location ~ "^/api/clash/subscriptions/[A-Za-z0-9_-]{16,}$" {
        proxy_pass http://127.0.0.1:19245;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 控制面 API ----
    # builtin 模式：直接反代控制面（控制面自带会话鉴权）。
    # sso 模式：把 /api/ 交给前置认证网关，由网关注入 X-Auth-User 后再反代控制面。
    location /api/ {
        proxy_pass http://127.0.0.1:19245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 前端 + SPA 回退（公开）----
    location / {
        proxy_pass http://127.0.0.1:19245;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTP → HTTPS 跳转
server {
    server_name <YOUR_DOMAIN>;
    listen 80;
    return 301 https://$host$request_uri;
}
