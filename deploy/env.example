# v2link-go 环境变量样例（真实值一律占位，绝不入库）。
# 复制到 /etc/v2link-go/env（systemd EnvironmentFile）后按部署环境填写。
# 键名与默认值逐条对齐旧实现 server/src/config.ts 的环境变量面板。

# ---- 监听 ----
PORT=19245
HOST=127.0.0.1

# ---- 数据面 xray ----
XRAY_API=127.0.0.1:8081
XRAY_BIN=xray
XRAY_INBOUND_TAG=vless-in
XRAY_API_TIMEOUT_S=3
XRAY_API_RETRIES=2

# ---- 链接时限 ----
DEFAULT_HOURS=24
MAX_HOURS=720

# ---- 调度周期（秒）----
EXPIRE_SCAN_INTERVAL_S=15
LEDGER_INTERVAL_S=30
XRAY_RECONCILE_INTERVAL_S=60
CONN_CLEANUP_INTERVAL_S=3600
CONN_RETENTION_S=604800
SAMPLE_CLEANUP_INTERVAL_S=86400
SAMPLE_RETENTION_S=2592000

# ---- access log 采集 ----
ACCESS_LOG_PATH=/var/log/xray/access.log

# ---- 地区连通性探测 ----
# REGION_PROBES=[{"key":"us","name":"美国","flag":"US","url":"https://example.com/generate_204"}]
REGION_PROBE_INTERVAL_S=300

# ---- 数据库（仅 MySQL）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=v2link
DB_USER=v2link
# DB_PASSWORD=                     # 口令只从环境注入，不入库
# DB_DSN=                          # 给出则整串生效，覆盖上面的分段参数

# ---- Clash 订阅 ----
CLASH_SUB_TTL_S=600
PUBLIC_BASE_URL=https://v2.example.com
CLASH_DIRECT_DOMAINS=

# ---- 公开地址（生成 vless:// 用）----
PUBLIC_HOST=v2.example.com
PUBLIC_PATH=/v2ws
# PUBLIC_SNI=

# ---- 管理端认证 ----
AUTH_MODE=builtin
V2LINK_ADMIN_USER=admin
# V2LINK_ADMIN_PASSWORD=        # 未设置则首启随机 16 位并打印一次
SESSION_TTL_HOURS=12
TRUST_PROXY=loopback
